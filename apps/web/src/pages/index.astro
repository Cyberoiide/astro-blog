---
import Layout from "@/layouts/Layout.astro"
---

<Layout pageTitle="Clément Bosle">
  <main class="mx-auto w-full max-w-4xl px-8 py-8 md:px-16 md:py-20">

    <div class="flex min-h-[calc(60svh-72px)] items-center justify-between">

      <div class="flex flex-col gap-8">

        <p class="text-xs font-medium tracking-widest text-blue-gray-400">
          Platform engineer &amp; music enthusiast - Paris, France
        </p>

        <h1 class="hero-name select-none">
          Clément<br />Bosle
        </h1>

        <div class="flex items-center gap-5">
          <div class="h-px w-10 bg-blue-gray-300"></div>
          <span class="text-xs tracking-widest text-blue-gray-400 uppercase">2026</span>
        </div>

      </div>

      <div class="hidden items-center md:flex">
        <figure class="cat-frame">
          <img
            src="/cat.jpg"
            alt="My cat"
            class="h-full w-full object-cover"
          />
        </figure>
      </div>

    </div>

  </main>
</Layout>

<style>
  .hero-name {
    font-family: var(--font-mono);
    font-size: clamp(4.5rem, 17vw, 5rem);
    font-weight: 800;
    line-height: 0.88;
    letter-spacing: -0.04em;
    color: var(--foreground);
    text-transform: uppercase;
  }

  .cat-frame {
    width: 220px;
    height: 280px;
    outline: 1px solid var(--border);
    overflow: hidden;
    background-color: var(--muted);
  }
</style>
