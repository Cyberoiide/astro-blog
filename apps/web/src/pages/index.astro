---
import Layout from "@/layouts/Layout.astro"

import { Button } from "@workspace/ui/components/button"
---

<Layout pageTitle="Clement Bosle | Portfolio">
  <div class="relative min-h-svh overflow-hidden bg-background">
    <div class="portfolio-gradient fixed inset-0 -z-20"></div>
    <div class="portfolio-noise pointer-events-none fixed inset-0 -z-10"></div>

    <!-- <CoffeeScene client:load /> -->

    <main class="relative z-20 flex min-h-svh items-center p-6 md:p-12">
      <div class="pointer-events-none select-none">
        <p class="mb-12 text-xs font-medium tracking-[0.3em] text-foreground/75 uppercase md:text-sm">
          Platform engineer and music enthusiast based in Paris, France.
        </p>
        <h1 class="portfolio-hero text-foreground">
          Clément<br />Bosle
        </h1>
      </div>
    </main>
  </div>
</Layout>

