---
import Layout from "@/layouts/Layout.astro"

import FaultyTerminal from '@workspace/ui/components/FaultyTerminal';

---

<Layout pageTitle="Clément Bosle">
  <main class="mx-auto w-full max-w-4xl px-8 py-8 md:px-16 md:py-20">

    <div class="flex min-h-[calc(60svh-72px)] items-center justify-between gap-12">

      <div class="flex flex-col gap-6 max-w-sm">

        <h1 class="text-4xl font-black leading-tight text-foreground md:text-5xl">
          Hey, I'm Clément. <br>I blablablabla.
        </h1>

        <p class="text-sm leading-relaxed text-blue-gray-500">
          Currently, I'm working as a platform engineer at Sia, in Paris, France.
        </p>

        <div class="flex items-center gap-6">
          put some socials here
        </div>

      </div>

      <div class="hidden items-center md:flex" style="width: 100%; height: 500px; position: relative;">
        <FaultyTerminal
          client:load
          scale={2.3}
          gridMul={[2, 1]}
          digitSize={1.9}
          timeScale={2.4}
          pause={false}
          scanlineIntensity={0.5}
          glitchAmount={1}
          flickerAmount={1}
          noiseAmp={1}
          chromaticAberration={0}
          dither={0}
          curvature={0.12}
          tint="#A7EF9E"
          mouseReact
          mouseStrength={1.2}
          pageLoadAnimation
          brightness={0.7}
        />
      </div>
    </div>

  </main>
</Layout>

<style>
  .hero-name {
    font-family: var(--font-mono);
    font-size: clamp(4.5rem, 17vw, 5rem);
    font-weight: 800;
    line-height: 0.88;
    letter-spacing: -0.04em;
    color: var(--foreground);
    text-transform: uppercase;
  }

  .cat-frame {
    width: 220px;
    height: 280px;
    outline: 1px solid var(--border);
    overflow: hidden;
    background-color: var(--muted);
  }
</style>
