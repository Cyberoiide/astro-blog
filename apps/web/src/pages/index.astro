---
import Layout from "@/layouts/Layout.astro"

import Dither from '@workspace/ui/components/Dither';

---

<Layout pageTitle="Clément Bosle">
  <main class="mx-auto w-full max-w-4xl px-8 py-8 md:px-16 md:py-20">

    <div class="flex min-h-[calc(60svh-72px)] items-center justify-between gap-12">

      <div class="flex flex-col gap-6 max-w-sm">

        <h1 class="text-4xl font-black leading-tight text-foreground md:text-5xl">
          Hey, I'm Clément. <br>I like to build products and make music.
        </h1>

        <p class="text-sm leading-relaxed text-blue-gray-500">
          Currently, I'm working as a platform engineer at Sia, in Paris, France.
        </p>

        <div class="flex items-center gap-6">
          put some socials here
        </div>

      </div>

      <div class="hidden items-center md:flex" style="width: 50%; height: 500px; position: relative;">
        <Dither
          client:load
          waveColor={[0.5, 0.5, 0.5]}
          disableAnimation={false}
          enableMouseInteraction
          mouseRadius={0.3}
          colorNum={4}
          waveAmplitude={0.3}
          waveFrequency={3}
          waveSpeed={0.05}
        />
      </div>
    </div>

  </main>
</Layout>

<style>
  .hero-name {
    font-family: var(--font-mono);
    font-size: clamp(4.5rem, 17vw, 5rem);
    font-weight: 800;
    line-height: 0.88;
    letter-spacing: -0.04em;
    color: var(--foreground);
    text-transform: uppercase;
  }

  .cat-frame {
    width: 220px;
    height: 280px;
    outline: 1px solid var(--border);
    overflow: hidden;
    background-color: var(--muted);
  }
</style>
