---
import Layout from "@/layouts/Layout.astro"
import Stack from "@/components/Stack.astro"
import ExperienceItem from "@/components/ExperienceItem.astro"
import AboutTitle from "@/components/AboutTitle.astro"

const pageTitle = "About — Clément Bosle"
---

<Layout pageTitle={pageTitle}>

  <div class="flex flex-col gap-16 py-4">

    <!-- Header -->
    <div class="flex flex-col gap-4">
      <AboutTitle blockTitle="About" />
      <h1 class="text-4xl font-black leading-tight text-foreground md:text-5xl">
        Clément Bosle
      </h1>
      <p class="text-sm leading-relaxed text-muted-foreground max-w-lg">
        Platform engineer in Paris. I build the infrastructure other engineers build on.
      </p>
    </div>

    <!-- Bio -->
    <div class="flex flex-col gap-4 border-t border-border pt-10">
      <AboutTitle blockTitle="Bio" />
      <div class="flex flex-col gap-3 max-w-lg">
        <p class="text-sm leading-relaxed text-muted-foreground">
          I think a lot about what makes systems easy to change and hard to break. My work sits somewhere between infra and product — close enough to both that neither team fully claims me.
        </p>
        <p class="text-sm leading-relaxed text-muted-foreground">
          Outside of work I read a lot, write here occasionally, and spend too much time thinking about tools.
        </p>
      </div>
    </div>

    <!-- Experience -->
    <div class="flex flex-col gap-6 border-t border-border pt-10">
      <AboutTitle blockTitle="Experience" />
      <div class="flex flex-col gap-6">
        <ExperienceItem
          company="Sia"
          role="Platform Engineer"
          period="2023 — present"
          description="Internal developer platforms, CI/CD pipelines, Kubernetes. Product teams are the customer."
        />
        <ExperienceItem
          company="Previous Role"
          role="Role Title"
          period="20XX — 20XX"
          description="Placeholder — update with your actual experience."
        />
      </div>
    </div>

    <!-- Stack -->
    <Stack tags={["Go", "TypeScript", "Kubernetes", "Terraform", "Helm", "ArgoCD", "GitHub Actions", "Prometheus", "Linux", "Bash"]} />

  </div>

</Layout>
